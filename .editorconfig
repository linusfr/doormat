root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Caddy's own formatter (`caddy fmt`) uses tabs, and the template follows suit.
[{Caddyfile,*.caddy,*.html}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[justfile]
indent_size = 4
